{
  "name": "relic-forge",
  "private": true,
  "version": "0.1.0",
  "description": "Gameplay telemetry becomes a one-of-one 3D weapon, forged by Meshy-7",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"pnpm --filter @relic/api dev\" \"pnpm --filter @relic/web dev\"",
    "start": "pnpm --filter @relic/api start",
    "build": "pnpm --filter @relic/core build && pnpm --filter @relic/api build && pnpm --filter @relic/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "spike": "pnpm --filter @relic/api spike"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.15.0"
}
