# Meshy API key — starts with msy_. Never commit the real value.
MESHY_API_KEY=

# Backend
PORT=8787
LOG_LEVEL=info

# Where generated assets and the cache index live (relative to apps/api)
STORAGE_DIR=./storage
CACHE_DIR=./cache

# Runaway-bug backstop. Generation refuses below this balance.
# Not a budget — credits are replenishable. This catches retry loops.
CREDIT_FLOOR=100

# Only when the client is hosted apart from this server, e.g. a static host in
# front of it. Leave empty for the single-origin deployment, where Fastify serves
# the built client itself and there is no cross-origin request to permit.
CLIENT_ORIGIN=
